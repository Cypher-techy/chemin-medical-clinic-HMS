// Production target: PostgreSQL — set provider="postgresql" and DATABASE_URL to Postgres (see DEPLOYMENT.md). SQLite used for zero-config local/offline node.
datasource db { provider = "sqlite" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }
model Facility { id String @id @default(cuid()) name String legalName String? county String subCounty String? mohCode String? kephLevel String? verified Boolean @default(false) createdAt DateTime @default(now()) departments Department[] users User[] beds Bed[] }
model Department { id String @id @default(cuid()) name String code String @unique facilityId String facility Facility @relation(fields:[facilityId],references:[id]) active Boolean @default(true) }
model User { id String @id @default(cuid()) email String @unique name String passwordHash String role String status String @default("ACTIVE") mfaEnabled Boolean @default(false) licenceNo String? licenceExpiry DateTime? mfaSecret String? facilityId String? facility Facility? @relation(fields:[facilityId],references:[id]) lastLoginAt DateTime? createdAt DateTime @default(now()) auditLogs AuditLog[] }
model Patient { id String @id @default(cuid()) patientNo String @unique firstName String middleName String? surname String dob DateTime sex String phone String? email String? residence String? emergencyContact String? nextOfKin String? nationalId String? status String @default("ACTIVE") registeredById String? mergedIntoId String? createdAt DateTime @default(now()) visits Visit[] appointments Appointment[] allergies Allergy[] invoices Invoice[] consents Consent[] guardians Guardian[] }
model Guardian { id String @id @default(cuid()) patientId String patient Patient @relation(fields:[patientId],references:[id]) guardianName String relationship String phone String? verified Boolean @default(false) }
model Consent { id String @id @default(cuid()) patientId String patient Patient @relation(fields:[patientId],references:[id]) type String granted Boolean grantedAt DateTime @default(now()) recordedById String? }
model Allergy { id String @id @default(cuid()) patientId String patient Patient @relation(fields:[patientId],references:[id]) allergen String reaction String? severity String @default("MODERATE") recordedById String? createdAt DateTime @default(now()) }
model Appointment { id String @id @default(cuid()) patientId String patient Patient @relation(fields:[patientId],references:[id]) department String practitionerId String? scheduledAt DateTime reason String? status String @default("BOOKED") source String @default("STAFF") createdById String? createdAt DateTime @default(now()) }
model Visit { id String @id @default(cuid()) patientId String patient Patient @relation(fields:[patientId],references:[id]) queueNo String department String type String @default("WALKIN") priority String @default("ROUTINE") status String @default("WAITING") clinicianId String? checkInAt DateTime @default(now()) startedAt DateTime? completedAt DateTime? encounters Encounter[] vitals Vital[] }
model Vital { id String @id @default(cuid()) visitId String visit Visit @relation(fields:[visitId],references:[id]) patientId String systolic Int? diastolic Int? pulse Int? respRate Int? tempC Float? spo2 Int? heightCm Float? weightKg Float? painScore Int? bmi Float? recordedById String? createdAt DateTime @default(now()) }
model Encounter { id String @id @default(cuid()) visitId String visit Visit @relation(fields:[visitId],references:[id]) patientId String clinicianId String chiefComplaint String? hpi String? pmh String? examination String? plan String? diagnoses String? status String @default("DRAFT") signedAt DateTime? signedById String? version Int @default(1) createdAt DateTime @default(now()) amendments Amendment[] prescriptions Prescription[] }
model Amendment { id String @id @default(cuid()) encounterId String encounter Encounter @relation(fields:[encounterId],references:[id]) field String oldValue String? newValue String reason String amendedById String createdAt DateTime @default(now()) }
model LabTest { id String @id @default(cuid()) code String @unique name String price Float unit String? refLow Float? refHigh Float? criticalLow Float? criticalHigh Float? active Boolean @default(true) }
model LabOrder { id String @id @default(cuid()) patientId String visitId String? testId String test LabTest @relation(fields:[testId],references:[id]) orderedById String status String @default("ORDERED") specimenId String? @unique resultValue Float? resultText String? flag String? verifiedById String? verifiedAt DateTime? acknowledgedAt DateTime? createdAt DateTime @default(now()) }
model Medicine { id String @id @default(cuid()) name String genericName String strength String form String unit String sellingPrice Float reorderLevel Int @default(20) active Boolean @default(true) batches Batch[] }
model Batch { id String @id @default(cuid()) medicineId String medicine Medicine @relation(fields:[medicineId],references:[id]) batchNo String expiry DateTime quantity Int receivedAt DateTime @default(now()) supplier String? }
model Prescription { id String @id @default(cuid()) encounterId String? encounter Encounter? @relation(fields:[encounterId],references:[id]) patientId String medicineId String medicine Medicine @relation(fields:[medicineId],references:[id]) dose String frequency String duration String quantity Int status String @default("PENDING") prescribedById String createdAt DateTime @default(now()) dispenses Dispense[] }
model Dispense { id String @id @default(cuid()) prescriptionId String prescription Prescription @relation(fields:[prescriptionId],references:[id]) batchId String quantity Int dispensedById String counselled Boolean @default(false) createdAt DateTime @default(now()) }
model Service { id String @id @default(cuid()) code String @unique name String price Float category String active Boolean @default(true) }
model Invoice { id String @id @default(cuid()) invoiceNo String @unique patientId String patient Patient @relation(fields:[patientId],references:[id]) status String @default("OPEN") total Float @default(0) createdById String? createdAt DateTime @default(now()) items InvoiceItem[] payments Payment[] }
model InvoiceItem { id String @id @default(cuid()) invoiceId String invoice Invoice @relation(fields:[invoiceId],references:[id]) description String quantity Int unitPrice Float amount Float }
model Payment { id String @id @default(cuid()) invoiceId String invoice Invoice @relation(fields:[invoiceId],references:[id]) method String amount Float reference String? @unique status String @default("VERIFIED") receivedById String? createdAt DateTime @default(now()) }
model MpesaTransaction { id String @id @default(cuid()) checkoutRequestId String @unique merchantRequestId String? invoiceId String? phone String amount Float status String @default("PENDING") receiptNo String? @unique createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model StockMovement { id String @id @default(cuid()) itemType String itemName String location String type String quantity Int reason String? recordedById String? createdAt DateTime @default(now()) }
model Supplier { id String @id @default(cuid()) name String contact String? email String? }
model Bed { id String @id @default(cuid()) label String ward String facilityId String facility Facility @relation(fields:[facilityId],references:[id]) status String @default("AVAILABLE") }
model Admission { id String @id @default(cuid()) patientId String bedId String diagnosis String status String @default("ADMITTED") admittedAt DateTime @default(now()) dischargedAt DateTime? dischargeSummary String? }
model Referral { id String @id @default(cuid()) patientId String destination String reason String urgency String @default("ROUTINE") notes String? status String @default("PENDING") outcome String? createdById String? createdAt DateTime @default(now()) }
model Incident { id String @id @default(cuid()) type String severity String description String patientId String? status String @default("OPEN") reportedById String? confidential Boolean @default(true) createdAt DateTime @default(now()) }
model Notification { id String @id @default(cuid()) channel String recipient String template String message String status String @default("QUEUED") patientId String? attempts Int @default(0) createdAt DateTime @default(now()) sentAt DateTime? }
model AuditLog { id String @id @default(cuid()) actorId String? actor User? @relation(fields:[actorId],references:[id]) action String target String targetId String? details String? ip String? createdAt DateTime @default(now()) }
model SyncEvent { id String @id @default(cuid()) entity String entityId String operation String payload String clientEventId String @unique status String @default("APPLIED") conflict String? createdAt DateTime @default(now()) }
model Setting { key String @id value String }
model InsuranceClaim { id String @id @default(cuid()) patientId String insurer String memberNo String? invoiceId String? status String @default("PREPARED") amount Float @default(0) createdAt DateTime @default(now()) }

model Asset { id String @id @default(cuid()) name String assetTag String @unique serialNo String? category String location String? department String? status String @default("IN_SERVICE") warrantyExpiry DateTime? nextMaintenance DateTime? createdAt DateTime @default(now()) }
